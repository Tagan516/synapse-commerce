# ====================================================================
# SYNAPSE COMMERCE GLOBAL MONO-REPO GITIGNORE
# ====================================================================

# --------------------------------------------------------------------
# 1. Operating System & IDE Files
# --------------------------------------------------------------------
# User-specific settings, caches, and logs from your code editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --------------------------------------------------------------------
# 2. Frontend / React (Node.js) Rules
# --------------------------------------------------------------------
# Blocks giant package folders and local build distributions
node_modules/
/frontend-client/dist/
/frontend-client/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --------------------------------------------------------------------
# 3. .NET / C# Global Rules (All APIs & Shared Projects)
# --------------------------------------------------------------------
# Ignores local compiled binaries and object folders across all projects
**/[Bb]in/
**/[Oo]bj/

# User-specific project settings
*.user
*.userprefs
*.pidb

# Secrets Guardrail: Only ignore this if you put actual secrets here.
# appsettings.Development.json

# --------------------------------------------------------------------
# 4. Analytics Service (Go) Rules
# --------------------------------------------------------------------
# Ignores compiled Go binaries and test coverages
/analytics-service/analytics-service
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# --------------------------------------------------------------------
# 5. Infrastructure & DevOps (Terraform & Docker) Rules
# --------------------------------------------------------------------
# Crucial: Prevents state files (which can contain AWS secrets) 
# from being exposed on GitHub.
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
.terraform.tfstate.lock.info

# Local environment variables containing credentials
.env
.env.local
.env.*.local

# Docker data volumes (if you map Postgres/RabbitMQ data to a local folder)
/docker_data/